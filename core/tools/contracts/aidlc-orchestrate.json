{
  "tool": "aidlc-orchestrate.ts",
  "commands": {
    "next": {
      "flags": [
        "--project-dir",
        "--unit",
        "--repo",
        "--continue-token",
        "--stage",
        "--single"
      ],
      "results": []
    },
    "report": {
      "flags": [
        "--project-dir",
        "--stage",
        "--result",
        "--user-input",
        "--reason",
        "--unit",
        "--single"
      ],
      "results": [
        "approved",
        "awaiting-approval",
        "completed",
        "complete",
        "done",
        "rejected",
        "revised",
        "skipped"
      ]
    }
  }
}
