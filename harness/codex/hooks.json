{
  "description": "AI-DLC advisory Sensors for Codex file edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_PROJECT_DIR=\"$PWD\" bun run --cwd \"$PWD/.codex\" sensor-hook",
            "commandWindows": "powershell -NoProfile -Command \"$root = (Get-Location).Path; $env:CODEX_PROJECT_DIR = $root; bun run --cwd \\\"$root/.codex\\\" sensor-hook\"",
            "timeout": 30,
            "statusMessage": "Running advisory AI-DLC Sensors"
          }
        ]
      }
    ]
  }
}
