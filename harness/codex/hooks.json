{
  "description": "AI-DLC advisory Sensors for Codex file edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_PROJECT_DIR=\"$(git rev-parse --show-toplevel)\" pnpm --dir \"$(git rev-parse --show-toplevel)/.codex\" run sensor-hook",
            "commandWindows": "powershell -NoProfile -Command \"$root = (git rev-parse --show-toplevel); $env:CODEX_PROJECT_DIR = $root; pnpm --dir \\\"$root/.codex\\\" run sensor-hook\"",
            "timeout": 30,
            "statusMessage": "Running advisory AI-DLC Sensors"
          }
        ]
      }
    ]
  }
}
