{
  "name": "aidlc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "aidlc": "bun core/tools/aidlc.ts",
    "binary:build": "bun scripts/build-binaries.ts",
    "binary:build:all": "bun scripts/build-binaries.ts --all-targets",
    "bundle:check": "bun core/tools/aidlc-codex-bundle.ts check",
    "bundle:write": "bun core/tools/aidlc-codex-bundle.ts write",
    "doctor": "bun core/tools/aidlc-vnext-doctor.ts",
    "graph:check": "bun core/tools/aidlc-core-route.ts validate",
    "graph:show": "bun core/tools/aidlc-core-route.ts show",
    "intent:birth": "bun core/tools/aidlc-intent.ts birth",
    "intent:list": "bun core/tools/aidlc-intent.ts list",
    "intent:switch": "bun core/tools/aidlc-intent.ts switch",
    "orchestrate:next": "bun core/tools/aidlc-vnext-orchestrate.ts next",
    "plan:show": "bun core/tools/aidlc-vnext-plan.ts show",
    "plan:revise": "bun core/tools/aidlc-vnext-plan.ts revise",
    "distribution:check": "bun scripts/package-github-release.ts --check-project",
    "distribution:write": "bun scripts/package-github-release.ts --write-project",
    "package:github": "bun scripts/package-github-release.ts",
    "release:check": "bun run version:check && bun run typecheck && bun run graph:check && bun test",
    "space:create": "bun core/tools/aidlc-space.ts create",
    "space:list": "bun core/tools/aidlc-space.ts list",
    "space:switch": "bun core/tools/aidlc-space.ts switch",
    "state:check": "bun core/tools/aidlc-vnext-state.ts check",
    "state:resume": "bun core/tools/aidlc-vnext-state.ts resume",
    "state:show": "bun core/tools/aidlc-vnext-state.ts show",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version:check": "bun scripts/check-version.ts",
    "workspace:init": "bun core/tools/aidlc-workspace.ts init"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.1.2",
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
