{
  "name": "aidlc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "agent:check": "tsx core/tools/aidlc-agent-loader.ts check",
    "agent:plan": "tsx core/tools/aidlc-executor.ts plan",
    "artifact:check": "tsx core/tools/aidlc-artifacts.ts check",
    "artifact:show": "tsx core/tools/aidlc-artifacts.ts show",
    "bundle:check": "tsx core/tools/aidlc-codex-bundle.ts check",
    "bundle:write": "tsx core/tools/aidlc-codex-bundle.ts write",
    "contract:check": "tsx core/tools/aidlc-runtime-contract.ts check",
    "doctor": "tsx core/tools/aidlc-doctor.ts",
    "graph:check": "tsx core/tools/aidlc-graph.ts compile --check",
    "graph:compile": "tsx core/tools/aidlc-graph.ts compile",
    "graph:resolve": "tsx core/tools/aidlc-graph.ts resolve",
    "intent:birth": "tsx core/tools/aidlc-intent.ts birth",
    "intent:list": "tsx core/tools/aidlc-intent.ts list",
    "intent:switch": "tsx core/tools/aidlc-intent.ts switch",
    "learnings:persist": "tsx core/tools/aidlc-learnings.ts persist",
    "learnings:surface": "tsx core/tools/aidlc-learnings.ts surface",
    "log:answer": "tsx core/tools/aidlc-log.ts answer",
    "log:decision": "tsx core/tools/aidlc-log.ts decision",
    "memory:init": "tsx core/tools/aidlc-memory.ts init",
    "orchestrate:next": "tsx core/tools/aidlc-orchestrate.ts next",
    "orchestrate:report": "tsx core/tools/aidlc-orchestrate.ts report",
    "release:check": "pnpm typecheck && pnpm graph:check && pnpm contract:check && pnpm test",
    "runner:check": "tsx core/tools/aidlc-runner-gen.ts check",
    "runner:list": "tsx core/tools/aidlc-runner-gen.ts list",
    "runner:write": "tsx core/tools/aidlc-runner-gen.ts write",
    "rule:check": "tsx core/tools/aidlc-rule-loader.ts check",
    "sensor:check": "tsx core/tools/aidlc-sensor-loader.ts check",
    "sensor:describe": "tsx core/tools/aidlc-sensor.ts describe",
    "sensor:fire": "tsx core/tools/aidlc-sensor.ts fire",
    "sensor:list": "tsx core/tools/aidlc-sensor.ts list",
    "scope:check": "tsx core/tools/aidlc-scope-loader.ts check",
    "space:create": "tsx core/tools/aidlc-space.ts create",
    "space:list": "tsx core/tools/aidlc-space.ts list",
    "space:switch": "tsx core/tools/aidlc-space.ts switch",
    "stage:check": "tsx core/tools/aidlc-stage-loader.ts check",
    "state:advance": "tsx core/tools/aidlc-state.ts advance",
    "state:check": "tsx core/tools/aidlc-state.ts check",
    "state:init": "tsx core/tools/aidlc-state.ts init",
    "state:practices-event": "tsx core/tools/aidlc-state.ts practices-event",
    "state:practices-promote": "tsx core/tools/aidlc-state.ts practices-promote",
    "state:resume": "tsx core/tools/aidlc-state.ts resume",
    "state:show": "tsx core/tools/aidlc-state.ts show",
    "state:skip": "tsx core/tools/aidlc-state.ts skip",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "unit:check": "tsx core/tools/aidlc-unit-graph.ts check",
    "unit:show": "tsx core/tools/aidlc-unit-graph.ts show",
    "utility:detect": "tsx core/tools/aidlc-utility.ts detect",
    "utility:scope-table": "tsx core/tools/aidlc-utility.ts scope-table",
    "utility:stage-table": "tsx core/tools/aidlc-utility.ts stage-table",
    "workspace:detect": "tsx core/tools/aidlc-workspace-detect.ts detect",
    "workspace:init": "tsx core/tools/aidlc-workspace.ts init",
    "workspace:migrate": "tsx core/tools/aidlc-workspace-migrate.ts migrate"
