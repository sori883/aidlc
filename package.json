{
  "name": "aidlc",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "aidlc": "bun core/tools/aidlc.ts",
    "agent:check": "bun core/tools/aidlc-agent-loader.ts check",
    "agent:plan": "bun core/tools/aidlc-executor.ts plan",
    "artifact:check": "bun core/tools/aidlc-artifacts.ts check",
    "artifact:show": "bun core/tools/aidlc-artifacts.ts show",
    "binary:build": "bun scripts/build-binaries.ts",
    "binary:build:all": "bun scripts/build-binaries.ts --all-targets",
    "bolt:next": "bun core/tools/aidlc-bolt.ts next",
    "bundle:check": "bun core/tools/aidlc-codex-bundle.ts check",
    "bundle:write": "bun core/tools/aidlc-codex-bundle.ts write",
    "contract:check": "bun core/tools/aidlc-runtime-contract.ts check",
    "doctor": "bun core/tools/aidlc-doctor.ts",
    "graph:check": "bun core/tools/aidlc-graph.ts compile --check",
    "graph:compile": "bun core/tools/aidlc-graph.ts compile",
    "graph:ars": "bun core/tools/aidlc-graph.ts ars",
    "graph:validate-grid": "bun core/tools/aidlc-graph.ts validate-grid",
    "graph:resolve": "bun core/tools/aidlc-graph.ts resolve",
    "intent:birth": "bun core/tools/aidlc-intent.ts birth",
    "intent:list": "bun core/tools/aidlc-intent.ts list",
    "intent:switch": "bun core/tools/aidlc-intent.ts switch",
    "learnings:persist": "bun core/tools/aidlc-learnings.ts persist",
    "learnings:surface": "bun core/tools/aidlc-learnings.ts surface",
    "log:answer": "bun core/tools/aidlc-log.ts answer",
    "log:decision": "bun core/tools/aidlc-log.ts decision",
    "memory:init": "bun core/tools/aidlc-memory.ts init",
    "orchestrate:next": "bun core/tools/aidlc-orchestrate.ts next",
    "orchestrate:report": "bun core/tools/aidlc-orchestrate.ts report",
    "quality-gate:check": "bun core/tools/aidlc-quality-gate.ts check",
    "distribution:check": "bun scripts/package-github-release.ts --check-project",
    "distribution:write": "bun scripts/package-github-release.ts --write-project",
    "package:github": "bun scripts/package-github-release.ts",
    "release:check": "bun run version:check && bun run typecheck && bun run graph:check && bun run contract:check && bun test",
    "runner:check": "bun core/tools/aidlc-runner-gen.ts check",
    "runner:list": "bun core/tools/aidlc-runner-gen.ts list",
    "runner:write": "bun core/tools/aidlc-runner-gen.ts write",
    "rule:check": "bun core/tools/aidlc-rule-loader.ts check",
    "sensor:check": "bun core/tools/aidlc-sensor-loader.ts check",
    "sensor:describe": "bun core/tools/aidlc-sensor.ts describe",
    "sensor:fire": "bun core/tools/aidlc-sensor.ts fire",
    "sensor:list": "bun core/tools/aidlc-sensor.ts list",
    "scope:check": "bun core/tools/aidlc-scope-loader.ts check",
    "space:create": "bun core/tools/aidlc-space.ts create",
    "space:list": "bun core/tools/aidlc-space.ts list",
    "space:switch": "bun core/tools/aidlc-space.ts switch",
    "stage:check": "bun core/tools/aidlc-stage-loader.ts check",
    "state:advance": "bun core/tools/aidlc-state.ts advance",
    "state:check": "bun core/tools/aidlc-state.ts check",
    "state:init": "bun core/tools/aidlc-state.ts init",
    "state:practices-event": "bun core/tools/aidlc-state.ts practices-event",
    "state:practices-promote": "bun core/tools/aidlc-state.ts practices-promote",
    "state:resume": "bun core/tools/aidlc-state.ts resume",
    "state:set-construction-iteration": "bun core/tools/aidlc-state.ts set-construction-iteration",
    "state:show": "bun core/tools/aidlc-state.ts show",
    "state:skip": "bun core/tools/aidlc-state.ts skip",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "unit:check": "bun core/tools/aidlc-unit-graph.ts check",
    "unit:show": "bun core/tools/aidlc-unit-graph.ts show",
    "utility:detect": "bun core/tools/aidlc-utility.ts detect",
    "utility:codekb-path": "bun core/tools/aidlc-utility.ts codekb-path",
    "utility:scope-table": "bun core/tools/aidlc-utility.ts scope-table",
    "utility:stage-table": "bun core/tools/aidlc-utility.ts stage-table",
    "utility:recompose": "bun core/tools/aidlc-utility.ts recompose",
    "version:check": "bun scripts/check-version.ts",
    "workspace:detect": "bun core/tools/aidlc-workspace-detect.ts detect",
    "workspace:init": "bun core/tools/aidlc-workspace.ts init",
    "workspace:migrate": "bun core/tools/aidlc-workspace-migrate.ts migrate",
    "worktree:create": "bun core/tools/aidlc-worktree.ts create",
    "worktree:discard": "bun core/tools/aidlc-worktree.ts discard",
    "worktree:info": "bun core/tools/aidlc-worktree.ts info",
    "worktree:list": "bun core/tools/aidlc-worktree.ts list",
    "worktree:merge": "bun core/tools/aidlc-worktree.ts merge",
    "worktree:validate": "bun core/tools/aidlc-worktree.ts validate",
    "worktree:verify": "bun core/tools/aidlc-worktree.ts verify"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
