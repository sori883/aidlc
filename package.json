{
  "name": "aidlc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "agent:check": "tsx core/tools/aidlc-agent-loader.ts check",
    "agent:plan": "tsx core/tools/aidlc-executor.ts plan",
    "graph:check": "tsx core/tools/aidlc-graph.ts compile --check",
    "graph:compile": "tsx core/tools/aidlc-graph.ts compile",
    "graph:resolve": "tsx core/tools/aidlc-graph.ts resolve",
    "intent:birth": "tsx core/tools/aidlc-intent.ts birth",
    "intent:list": "tsx core/tools/aidlc-intent.ts list",
    "intent:switch": "tsx core/tools/aidlc-intent.ts switch",
    "orchestrate:next": "tsx core/tools/aidlc-orchestrate.ts next",
    "orchestrate:report": "tsx core/tools/aidlc-orchestrate.ts report",
    "rule:check": "tsx core/tools/aidlc-rule-loader.ts check",
    "sensor:check": "tsx core/tools/aidlc-sensor-loader.ts check",
    "scope:check": "tsx core/tools/aidlc-scope-loader.ts check",
    "space:create": "tsx core/tools/aidlc-space.ts create",
    "space:list": "tsx core/tools/aidlc-space.ts list",
    "space:switch": "tsx core/tools/aidlc-space.ts switch",
    "stage:check": "tsx core/tools/aidlc-stage-loader.ts check",
    "state:advance": "tsx core/tools/aidlc-state.ts advance",
    "state:check": "tsx core/tools/aidlc-state.ts check",
    "state:init": "tsx core/tools/aidlc-state.ts init",
    "state:resume": "tsx core/tools/aidlc-state.ts resume",
    "state:show": "tsx core/tools/aidlc-state.ts show",
    "state:skip": "tsx core/tools/aidlc-state.ts skip",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "workspace:detect": "tsx core/tools/aidlc-workspace-detect.ts detect",
    "workspace:init": "tsx core/tools/aidlc-workspace.ts init",
    "workspace:migrate": "tsx core/tools/aidlc-workspace-migrate.ts migrate"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
